# Copy to .env.local for local dev. In production these come from Secret Manager.

# Public base URL of this app. Must be explicit behind Cloud Run's proxy, or OAuth fails
# with redirect_uri_mismatch. Prod: https://conduit.<your-domain>
BETTER_AUTH_URL=http://localhost:3001
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
DATABASE_URL=postgres://conduit:conduit@127.0.0.1:15433/conduit
# FastAPI service (verifies JWTs from this app via /api/auth/jwks).
API_URL=http://localhost:8001

# OAuth apps. Buttons hide until both values of a provider are set.
# Google redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google  (scopes: openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback URL: <BETTER_AUTH_URL>/api/auth/callback/github  (one OAuth app per environment)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Account email (address confirmation, password reset) via Resend: https://resend.com
# Leave both empty locally: links are printed to the dev server log instead.
# Required in production; sign-up fails loudly without them.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Name <auth@your-domain>".
RESEND_API_KEY=
EMAIL_FROM=
